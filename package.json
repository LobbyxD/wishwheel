{
  "name": "wishwheel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/devstart.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "dev:ui": "vite --host 0.0.0.0",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply wishwheel-data --local",
    "db:migrate:remote": "wrangler d1 migrations apply wishwheel-data --remote"
  },
  "dependencies": {
    "jose": "6.2.14",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "happy-dom": "21.0.4",
    "miniflare": "5.20261023.3-beta",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.156.0"
  }
}
